---
import Layout from "@layouts/Layout.astro"
import { Image } from "astro:assets"
import profilePicCircle from "@assets/profile-pic-circle.webp"
import emailIcon from "@assets/email-alt.svg"
import githubIcon from "@assets/github-alt.svg"
import linkedInIcon from "@assets/linkedin-alt.svg"
---

<Layout title="contact." headerTitle="contact." disableScroll>
    <div
        class="flex h-full flex-col justify-between gap-10 px-6 pb-8 md:gap-12 md:px-10 md:pb-10 lg:h-2/3 lg:flex-row lg:items-center lg:justify-evenly lg:gap-16 lg:px-0 lg:pb-0"
    >
        <div class="mt-2 flex flex-col gap-8 md:mt-4 md:gap-10 lg:gap-12">
            <div class="flex flex-col gap-1">
                <h2 class="text-5xl md:text-6xl lg:text-5xl">lets talk.</h2>
                <p
                    class="max-w-[24ch] text-xl font-light xs:text-2xl md:text-3xl lg:text-3xl"
                >
                    Got an opportunity or found a bug in something I built?
                </p>
            </div>
            <div class="flex flex-col gap-3 md:gap-4">
                <a
                    href="mailto:contact@tnitish.com"
                    class="group flex items-center gap-2"
                >
                    <Image
                        src={emailIcon}
                        alt="Email"
                        class="md:size-4xl size-8 xs:size-10"
                    />
                    <p
                        class="-mt-1 align-top text-xl xs:text-2xl md:text-3xl lg:text-3xl"
                    >
                        contact@tnitish.com <span
                            class="-mt-0.5 block h-[2px] max-w-0 rounded-sm bg-white transition-all duration-300 group-hover:max-w-full"
                        ></span>
                    </p>
                </a>
                <a
                    href="https://github.tnitish.com/"
                    target="_blank"
                    class="group flex items-center gap-2"
                >
                    <Image
                        src={githubIcon}
                        alt="GitHub"
                        class="md:size-4xl size-8 xs:size-10"
                    />
                    <p
                        class="-mt-1 align-top text-xl xs:text-2xl md:text-3xl lg:text-3xl"
                    >
                        techsupportz <span
                            class="-mt-0.5 block h-[2px] max-w-0 rounded-sm bg-white transition-all duration-300 group-hover:max-w-full"
                        ></span>
                    </p>
                </a>
                <a
                    href="https://linkedin.tnitish.com/"
                    target="_blank"
                    class="group flex items-center gap-2"
                >
                    <Image
                        src={linkedInIcon}
                        alt="LinkedIn"
                        class="md:size-4xl size-8 xs:size-10"
                    />
                    <p
                        class="align-top text-xl xs:text-2xl md:text-3xl lg:text-3xl"
                    >
                        Nitish Thiyagarajan <span
                            class="-mt-0.5 block h-[2px] max-w-0 rounded-sm bg-white transition-all duration-300 group-hover:max-w-full"
                        ></span>
                    </p>
                </a>
            </div>
        </div>
        <div class="relative mx-auto mt-2 w-fit md:mt-6 lg:mx-0 lg:mt-0">
            <Image
                src={profilePicCircle}
                alt="Profile Picture"
                class="relative z-10 size-[260px] object-cover xs:size-[280px] md:size-[320px] lg:size-[396px]"
            />
            <div
                class="dot-matrix absolute top-[25%] left-[25%] z-0 size-[240px] bg-[url('/dot-matrix.svg')] bg-repeat opacity-30 xs:top-[25%] xs:left-[25%] xs:size-[260px] md:top-1/3 md:left-[42%] md:size-[300px] lg:top-1/4 lg:left-1/3 lg:size-[348px]"
            >
            </div>
        </div>
    </div>
</Layout>
