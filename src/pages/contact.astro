---
import Layout from "@layouts/Layout.astro"
import { Image } from "astro:assets"
import profilePicCircle from "@assets/profile-pic-circle.webp"
import emailIcon from "@assets/email-alt.svg"
import githubIcon from "@assets/github-alt.svg"
import linkedInIcon from "@assets/linkedin-alt.svg"
import { ClipboardCheck, Copy, CopyCheck } from "@lucide/astro"
---

<Layout title="contact." headerTitle="contact." disableScroll>
    <div
        class="flex max-h-2/3 flex-col justify-evenly gap-10 px-6 md:px-8 lg:h-2/3 lg:flex-row lg:items-center lg:justify-evenly lg:gap-0 lg:px-4"
    >
        <div class="mt-2 flex flex-col gap-8 md:mt-4 md:gap-10 lg:gap-12">
            <div class="flex flex-col gap-1">
                <h2 class="text-3xl xs:text-4xl lg:text-5xl">lets talk.</h2>
                <p
                    class="text-xl font-light text-balance xs:text-2xl lg:max-w-[24ch] xl:max-w-full"
                >
                    Got an opportunity or found a bug in something I built?
                </p>
            </div>
            <div class="flex flex-col gap-3 md:gap-4">
                <div
                    class="group copy-email flex cursor-pointer items-center gap-2"
                >
                    <Image
                        src={emailIcon}
                        alt="Email"
                        class="size-7 xs:size-8 md:size-9"
                    />
                    <p
                        class="-mt-1 align-top text-lg xs:text-xl md:text-2xl lg:text-3xl"
                    >
                        contact@tnitish.com
                    </p>
                    <div class="relative size-6 self-center">
                        <Copy
                            class="copy-icon absolute inset-0 motion-scale-out-50 motion-blur-out-md opacity-0 transition-opacity motion-duration-200 group-hover:motion-scale-in-50 group-hover:motion-blur-in-md group-hover:opacity-100"
                        />
                        <ClipboardCheck
                            class="copy-success-icon absolute inset-0 opacity-0 transition-opacity motion-duration-150"
                        />
                    </div>
                </div>
                <a
                    href="https://github.tnitish.com/"
                    target="_blank"
                    class="group flex items-center gap-2"
                >
                    <Image
                        src={githubIcon}
                        alt="GitHub"
                        class="size-7 xs:size-8 md:size-9"
                    />
                    <p
                        class="-mt-1 align-top text-lg xs:text-xl md:text-2xl lg:text-3xl"
                    >
                        techsupportz <span
                            class="-mt-0.5 block h-[2px] max-w-0 rounded-sm bg-white transition-all duration-300 group-hover:max-w-full"
                        ></span>
                    </p>
                </a>
                <a
                    href="https://linkedin.tnitish.com/"
                    target="_blank"
                    class="group flex items-center gap-2"
                >
                    <Image
                        src={linkedInIcon}
                        alt="LinkedIn"
                        class="size-7 xs:size-8 md:size-9"
                    />
                    <p
                        class="align-top text-lg xs:text-xl md:text-2xl lg:text-3xl"
                    >
                        Nitish Thiyagarajan <span
                            class="-mt-0.5 block h-[2px] max-w-0 rounded-sm bg-white transition-all duration-300 group-hover:max-w-full"
                        ></span>
                    </p>
                </a>
            </div>
        </div>
        <div class="relative mr-16 ml-auto w-fit md:mr-20 lg:mx-0 lg:mt-0">
            <Image
                src={profilePicCircle}
                loading={"eager"}
                alt="Profile Picture"
                class="relative z-10 size-[260px] object-contain xs:size-[300px] md:size-[348px] lg:size-[364px] xl:size-[396px]"
            />
            <div
                class="dot-matrix absolute top-1/4 left-1/3 z-0 size-[240px] bg-[url('/dot-matrix.svg')] bg-repeat object-contain opacity-30 xs:size-[252px] md:size-[300px] lg:size-[316px] xl:size-[348px]"
            >
            </div>
        </div>
    </div>
</Layout>

<script>
    const copyEmail = document.querySelector(".copy-email")
    const copySuccessIcon =
        document.querySelector<HTMLElement>(".copy-success-icon")
    const copyIcon = document.querySelector<HTMLElement>(".copy-icon")

    // Class groups for Copy icon states
    const copyIconHoverClasses = [
        "group-hover:motion-scale-in-50",
        "group-hover:motion-blur-in-md",
        "group-hover:opacity-100",
    ]
    const copyIconOutClasses = [
        "motion-scale-out-50",
        "motion-blur-out-md",
        "!opacity-0",
    ]

    // Class groups for ClipboardCheck icon states
    const successIconInClasses = ["motion-scale-in-50", "motion-opacity-in-0"]
    const successIconOutClasses = [
        "motion-scale-out-50",
        "motion-opacity-out-0",
        "motion-duration-200",
    ]

    let copying = false
    let resetTimeout: ReturnType<typeof setTimeout> | null = null
    let exitTimeout: ReturnType<typeof setTimeout> | null = null

    function reset() {
        // Animate ClipboardCheck out (reverse of entry)
        if (copySuccessIcon) {
            copySuccessIcon.classList.remove(...successIconInClasses)
            copySuccessIcon.classList.add(...successIconOutClasses)
        }

        if (exitTimeout) clearTimeout(exitTimeout)
        exitTimeout = setTimeout(() => {
            // After exit animation completes, restore Copy icon hover-ready state
            if (copySuccessIcon) {
                copySuccessIcon.classList.remove(...successIconOutClasses)
                copySuccessIcon.classList.add("opacity-0")
            }

            if (copyIcon) {
                copyIcon.classList.remove(...copyIconOutClasses)
                copyIcon.classList.add(...copyIconHoverClasses)
            }

            copying = false
        }, 75)
    }

    copyEmail?.addEventListener("click", () => {
        if (copying) return
        copying = true

        navigator.clipboard.writeText("contact@tnitish.com")

        // Animate Copy icon out
        if (copyIcon) {
            copyIcon.classList.remove(...copyIconHoverClasses)
            copyIcon.classList.add(...copyIconOutClasses)
        }

        // Animate ClipboardCheck icon in
        if (copySuccessIcon) {
            copySuccessIcon.classList.remove("opacity-0")
            copySuccessIcon.classList.add(...successIconInClasses)
        }

        // Auto-reset after 1s
        resetTimeout = setTimeout(reset, 1000)
    })

    copyEmail?.addEventListener("mouseleave", () => {
        if (!copying) return
        if (resetTimeout) clearTimeout(resetTimeout)
        reset()
    })
</script>
