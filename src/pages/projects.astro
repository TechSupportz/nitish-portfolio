---
import ProjectCard from "@components/project/card/ProjectCard.astro"
import ProjectsEggPrompt from "@components/project/terminal/easter-egg/ProjectsEggPrompt.astro"
import ProjectsTerminal from "@components/project/terminal/ProjectsTerminal.astro"
import Layout from "@layouts/Layout.astro"
import { projectGroups as groups } from "@content/projects"
---

<Layout title="projects." headerTitle="projects.">
    <div data-projects class="lg:flex lg:px-12 lg:pt-12 xl:px-16">
        <ProjectsTerminal groups={groups} />
        <div class="flex w-full motion-preset-focus flex-col gap-12 px-6 pt-12 motion-delay-75 motion-duration-1000 md:px-8 lg:ml-[25vw] lg:w-3/4 lg:gap-16 lg:px-0 lg:pt-0 lg:pb-40 wmax:ml-100">
            {groups.flatMap(group =>
                group.items.map(project => <ProjectCard {...project} />),
            )}
            <div
                data-egg-slot
                class="relative -mx-6 overflow-x-clip px-6 pb-60 font-code text-sm md:-mx-8 md:px-8 lg:hidden"
            >
                <ProjectsEggPrompt mobile />
            </div>
        </div>
    </div>
</Layout>

<script>
    import { createProjectNavigation } from "@components/project/navigation/projectNavigation"
    import { createProjectsTerminal } from "@components/project/terminal/projectsTerminal"
    import { onPageLoad } from "@utils/pageLifecycle"

    onPageLoad(signal => {
        const page = document.querySelector<HTMLElement>("[data-projects]")
        if (!page) return

        const reduced = matchMedia("(prefers-reduced-motion: reduce)")
        const navigation = createProjectNavigation(page, signal, reduced)
        const terminal = createProjectsTerminal(
            page,
            signal,
            reduced,
            navigation,
        )
        navigation.watch(terminal.setActive, terminal.isOpen)
    })
</script>
