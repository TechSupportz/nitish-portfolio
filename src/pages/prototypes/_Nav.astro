---
import Highlight from "@components/Highlight.astro"
import Logo from "./_Logo.astro"

type Props = {
    // Boot tempo for the mark; measured (1.8s) when omitted.
    tempo?: "brisk" | "measured" | "slow"
    active?: string
}

const { tempo, active } = Astro.props
const links = [
    { href: "/so-far", label: "so far" },
    { href: "/projects", label: "projects" },
    { href: "/prototypes/contact", label: "contact" },
]
---

<nav class="z-20 w-full bg-charcoal font-display shadow-charcoal">
    <div
        class="m-auto flex h-full max-w-[1600px] items-center justify-between px-4 py-3 shadow-2xl md:px-8"
    >
        <a
            href="/"
            data-logo="lit"
            data-logo-tempo={tempo}
            class="p-logo-host flex size-12 items-center md:size-14"
            aria-label="nitish, home"
        >
            <Logo class="w-10 md:w-12" />
        </a>
        <div class="flex flex-row items-center gap-4 text-base text-white sm:gap-6 sm:text-xl">
            {
                links.map(({ href, label }) => (
                    <a href={href} class="group">
                        <Highlight>{label}</Highlight>
                        <span
                            class:list={[
                                "p-stop text-xl sm:text-2xl",
                                { "opacity-0": label !== active },
                            ]}
                        >
                            .
                        </span>
                    </a>
                ))
            }
        </div>
    </div>
</nav>
