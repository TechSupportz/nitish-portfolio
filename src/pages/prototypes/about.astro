---
import Picker from "./_Picker.astro"
import Shell from "./_Shell.astro"

// Months are counted from apr 2021 (index 0) to dec 2029 (index 104).
const at = (y: number, m: number) => (y - 2021) * 12 + (m - 4)

// Newest first. Copy follows the resume source in ~/Documents/Resume.
const entries = [
    {
        key: "nus",
        short: "nus",
        kind: "study",
        start: at(2026, 8),
        end: at(2029, 12),
        dates: "aug 2026 — dec 2029",
        expected: true,
        title: "National University of Singapore",
        subtitle: "Bachelor of Computing (Honours) in Computer Science",
        bullets: ["Awarded the Stephen Riady Young Entrepreneur Scholars (SRYES) Scholarship."],
    },
    {
        key: "govtech",
        short: "govtech",
        kind: "work",
        start: at(2023, 4),
        end: at(2024, 4),
        dates: "apr 2023 — apr 2024",
        expected: false,
        title: "GovTech Singapore",
        subtitle: "Software Engineer Intern",
        bullets: [
            "Built the CCUBE Admin Portal on my own, so configuring Listing Layer services no longer meant Postman requests and hand-edited SQL and config files.",
            "Added a Monaco config editor with IntelliSense and type checking, so malformed service JSON gets caught before it's applied.",
            "Worked with UX designers and internal users to turn one huge config form into focused flows, with validation and confirmations for risky changes.",
        ],
    },
    {
        key: "tp",
        short: "temasek poly",
        kind: "study",
        start: at(2021, 4),
        end: at(2024, 5),
        dates: "apr 2021 — may 2024",
        expected: false,
        title: "Temasek Polytechnic",
        subtitle: "Diploma in Information Technology with Merit · GPA 3.99",
        bullets: [
            "Lee Kuan Yew Award for Mathematics and Science, AWS Singapore Course Gold Medal and IMDA Excellence Award.",
            "Accenture Award as the top student in Cloud Application Development, for TPOSS: Reimagined.",
        ],
    },
]
const timeline = JSON.stringify(
    entries.map(({ key, short, start, end }) => ({ key, short, start, end })),
)
---

<Shell title="so far · prototype" headerTitle="so far" active="so far">
    <div id="stage" class="pb-32"></div>

    <!-- 1 · Months: one dot per month. Scrub across it to see what was going on. -->
    <template data-proto-variant>
        <div data-months data-entries={timeline} class="mx-auto max-w-6xl px-6 md:px-8 lg:px-12">
            <div class="font-code flex items-baseline justify-between gap-4 text-xs text-white/50">
                <span>one dot = one month</span>
                <span class="hidden sm:inline">hover or drag to scrub · ← → to step</span>
                <span class="sm:hidden">drag to scrub</span>
            </div>
            <svg
                data-mo-grid
                tabindex="0"
                role="slider"
                aria-label="Scrub through time"
                aria-valuemin="0"
                aria-valuemax="104"
                class="p-mo mt-3 block w-full"
            ></svg>
            <p class="font-code mt-8 text-sm">
                <span class="p-stop">❯</span>
                <span data-mo-readout>—</span>
                <span data-mo-tag class="text-[var(--accent)]"></span>
            </p>
            <div class="mt-4 grid gap-10 lg:grid-cols-2 lg:gap-14" aria-live="polite">
                {
                    entries.map(entry => (
                        <article data-mo-card={entry.key} hidden>
                            <p class="font-code text-xs text-white/50">
                                {entry.kind} · {entry.dates}
                                {entry.expected && " · expected"}
                            </p>
                            <h2 class="mt-1.5 text-2xl leading-tight xl:text-[1.75rem]">
                                {entry.title}
                                <span class="p-stop">.</span>
                            </h2>
                            <p class="mt-1 text-white/70">{entry.subtitle}</p>
                            <ul class="p-bullets mt-4 max-w-[62ch] space-y-1.5 text-[15px] leading-relaxed text-pretty text-white/85 lg:text-base">
                                {entry.bullets.map(bullet => (
                                    <li>{bullet}</li>
                                ))}
                            </ul>
                        </article>
                    ))
                }
                <p data-mo-empty hidden class="text-white/50">Nothing logged for this stretch.</p>
            </div>
        </div>
    </template>

    <!-- 2 · Rewind: scrolling down runs the clock backwards on an LED year counter. -->
    <template data-proto-variant>
        <div
            data-rewind
            class="mx-auto max-w-6xl px-6 md:grid md:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] md:gap-14 md:px-8 lg:px-12"
        >
            <div class="p-rw-clock sticky z-10 self-start pb-5 md:pb-0">
                <svg data-rw-year class="w-36 md:w-full md:max-w-64" viewBox="0 0 230 70" aria-hidden="true"
                ></svg>
                <p class="font-code mt-3 text-sm">
                    <span data-rw-month>nov</span>
                    <span data-rw-tag class="text-[var(--accent)]">· now</span>
                </p>
                <p class="font-code mt-1 hidden text-xs text-white/40 md:block">scroll to rewind ↓</p>
            </div>
            <ol class="relative pb-[45vh] pl-10 md:pt-2">
                <div data-rw-rail class="p-rw-rail absolute top-2 bottom-[45vh] left-3" aria-hidden="true">
                    <div data-rw-lit class="p-rw-lit absolute inset-0"></div>
                </div>
                {
                    entries.map(entry => (
                        <li data-rw-entry data-start={entry.start} class="p-rw-entry relative pb-20">
                            <span class="p-rw-node" aria-hidden="true" />
                            <p class="font-code text-xs text-white/50">
                                {entry.kind} · {entry.dates}
                                {entry.expected && " · expected"}
                            </p>
                            <h2 class="mt-1.5 text-2xl leading-tight xl:text-[1.75rem]">
                                {entry.title}
                                <span class="p-stop">.</span>
                            </h2>
                            <p class="mt-1 text-white/70">{entry.subtitle}</p>
                            <ul class="p-bullets mt-4 max-w-[62ch] space-y-1.5 text-[15px] leading-relaxed text-pretty text-white/85 lg:text-base">
                                {entry.bullets.map(bullet => (
                                    <li>{bullet}</li>
                                ))}
                            </ul>
                        </li>
                    ))
                }
            </ol>
        </div>
    </template>

    <Picker names={["Months", "Rewind"]} replay />
</Shell>

<style is:global>
    /* ---------- Months ---------- */

    .p-mo {
        touch-action: pan-y;
        cursor: crosshair;
        overflow: visible;
    }

    .p-mo:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 6px;
        border-radius: 4px;
    }

    .p-mo .off {
        fill: rgb(255 255 255 / 0.11);
    }

    /* Months still to come: the LED is there but not lit yet. */
    .p-mo .exp {
        fill: transparent;
        stroke: rgb(96 165 250 / 0.65);
        stroke-width: 1.1;
    }

    .p-mo .row {
        transition: opacity 150ms ease-out;
    }

    .p-mo .row[data-dim] {
        opacity: 0.3;
    }

    .p-mo text {
        font-family: "Fira Code", ui-monospace, monospace;
        font-size: 12px;
        fill: rgb(255 255 255 / 0.45);
    }

    .p-mo .row-label {
        cursor: pointer;
        transition: fill 150ms ease-out;
    }

    .p-mo .row:not([data-dim]) .row-label {
        fill: #fff;
    }

    .p-mo .now-label {
        fill: var(--accent);
    }

    .p-mo .scrub {
        fill: rgb(255 255 255 / 0.08);
    }

    .p-mo .now-dot {
        fill: var(--accent);
        filter: drop-shadow(0 0 4px rgb(96 165 250 / 0.8));
    }

    /* First paint: the lit months power on left to right. */
    .p-mo.is-boot .lit,
    .p-mo.is-boot .exp {
        animation: p-mo-on 220ms var(--ease-out-strong) var(--d, 0ms) backwards;
    }

    @keyframes p-mo-on {
        from {
            opacity: 0;
        }
    }

    /* ---------- Rewind ---------- */

    .p-rw-clock {
        top: 13rem;
        background: #121212;
    }

    @media (min-width: 456px) {
        .p-rw-clock {
            top: 14rem;
        }
    }

    @media (min-width: 768px) {
        .p-rw-clock {
            top: 19rem;
            background: none;
        }
    }

    .p-rw-clock .off {
        fill: rgb(255 255 255 / 0.08);
    }

    .p-rw-rail {
        width: 3px;
        background: radial-gradient(circle, rgb(255 255 255 / 0.25) 1.2px, transparent 1.6px) 0 0 / 3px
            7px repeat-y;
    }

    .p-rw-lit {
        background: radial-gradient(circle, var(--accent) 1.3px, transparent 1.7px) 0 0 / 3px 7px
            repeat-y;
        filter: drop-shadow(0 0 3px rgb(96 165 250 / 0.7));
        clip-path: inset(0 0 100% 0);
    }

    .p-rw-node {
        position: absolute;
        top: 0.2rem;
        left: calc(-1.75rem - 0.425rem + 1.5px);
        width: 0.85rem;
        height: 0.85rem;
        border-radius: 50%;
        background: #121212;
        box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.4);
        transition:
            background-color 200ms ease-out,
            box-shadow 200ms ease-out;
    }

    .p-rw-entry > :not(.p-rw-node) {
        opacity: 0.35;
        transition: opacity 250ms ease-out;
    }

    .p-rw-entry[data-lit] > :not(.p-rw-node) {
        opacity: 1;
    }

    .p-rw-entry[data-lit] .p-rw-node {
        background: var(--accent);
        box-shadow: 0 0 10px rgb(96 165 250 / 0.7);
    }

    @media (prefers-reduced-motion: reduce) {
        .p-mo.is-boot .lit,
        .p-mo.is-boot .exp {
            animation: none;
        }

        .p-mo .row,
        .p-rw-entry > *,
        .p-rw-node {
            transition: none;
        }
    }
</style>

<script>
    type Entry = { key: string; short: string; start: number; end: number }

    const NS = "http://www.w3.org/2000/svg"
    const SPAN = 105 // apr 2021 .. dec 2029
    const NAMES = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
    const reduced = matchMedia("(prefers-reduced-motion: reduce)")

    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v))
    const NOW = (() => {
        const d = new Date()
        return clamp((d.getFullYear() - 2021) * 12 + d.getMonth() + 1 - 4, 0, SPAN - 1)
    })()
    const monthName = (i: number) => NAMES[(i + 3) % 12]
    const yearOf = (i: number) => 2021 + Math.floor((i + 3) / 12)

    const el = <K extends keyof SVGElementTagNameMap>(
        tag: K,
        attrs: Record<string, string | number>,
    ) => {
        const node = document.createElementNS(NS, tag)
        for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v))
        return node
    }

    // Brand gradient sky-100 -> blue-500 across the whole span.
    const mix = (a: number, b: number, t: number) => Math.round(a + (b - a) * t)
    const lit = (t: number) => `rgb(${mix(224, 59, t)} ${mix(242, 130, t)} ${mix(254, 246, t)})`

    // ---------- Months ----------

    const initMonths = () => {
        const root = document.querySelector<HTMLElement>("[data-months]:not([data-ready])")
        if (!root) return
        root.dataset.ready = ""
        const svg = root.querySelector<SVGSVGElement>("[data-mo-grid]")!
        const readout = root.querySelector<HTMLElement>("[data-mo-readout]")!
        const tag = root.querySelector<HTMLElement>("[data-mo-tag]")!
        const cards = [...root.querySelectorAll<HTMLElement>("[data-mo-card]")]
        const empty = root.querySelector<HTMLElement>("[data-mo-empty]")!
        // Oldest on top, so the bars step down to the right like a staircase.
        const entries = (JSON.parse(root.dataset.entries!) as Entry[]).reverse()

        let scrub = NOW
        let geo = { labelW: 0, pitch: 1, step: 1, units: SPAN }
        let rows: SVGGElement[] = []
        let bar: SVGRectElement | null = null
        let booted = false

        const render = () => {
            const W = root.clientWidth - parseFloat(getComputedStyle(root).paddingLeft) * 2
            const labelW = W < 640 ? 92 : 124
            const step = (W - labelW) / SPAN >= 6 ? 1 : 3 // months, or quarters on phones
            const units = Math.ceil(SPAN / step)
            const pitch = (W - labelW) / units
            const r = Math.min(pitch * 0.3, 3.3)
            const rowH = 26
            const top = 26
            const H = top + entries.length * rowH + 28
            geo = { labelW, pitch, step, units }

            svg.replaceChildren()
            svg.setAttribute("viewBox", `0 0 ${W} ${H}`)
            svg.setAttribute("height", String(H))
            const cx = (u: number) => labelW + u * pitch + pitch / 2

            bar = el("rect", { class: "scrub", y: top - 12, width: pitch, height: entries.length * rowH + 4, rx: 2 })
            svg.append(bar)

            rows = entries.map((entry, i) => {
                const y = top + i * rowH
                const g = el("g", { class: "row" })
                const label = el("text", { class: "row-label", x: 0, y: y + 4 })
                label.textContent = W < 640 && entry.key === "tp" ? "tp" : entry.short
                label.addEventListener("click", () => setScrub(entry.start))
                g.append(label)
                for (let u = 0; u < units; u++) {
                    const from = u * step
                    const to = from + step - 1
                    const on = entry.start <= to && entry.end >= from
                    const future = from > NOW
                    const dot = el("circle", { cx: cx(u), cy: y, r })
                    if (on && future) dot.setAttribute("class", "exp")
                    else if (on) {
                        dot.setAttribute("class", "lit")
                        dot.setAttribute("fill", lit(u / (units - 1)))
                    } else dot.setAttribute("class", "off")
                    if (on) dot.style.setProperty("--d", `${Math.round(from * 5)}ms`)
                    g.append(dot)
                }
                svg.append(g)
                return g
            })

            // Year ticks along the bottom, at each january.
            const axisY = top + entries.length * rowH + 10
            for (let y = 2022; y <= 2029; y++) {
                const u = Math.floor(((y - 2021) * 12 - 3) / step)
                const t = el("text", { x: cx(u), y: axisY, "text-anchor": "middle" })
                t.textContent = W < 640 ? `'${String(y).slice(2)}` : String(y)
                svg.append(t)
            }

            // Now: the logo's dot, sitting on top of the current month.
            const nu = Math.floor(NOW / step)
            svg.append(el("circle", { class: "now-dot", cx: cx(nu), cy: 6, r: 3.5 }))
            const nl = el("text", { class: "now-label", x: cx(nu) + 8, y: 10 })
            nl.textContent = "now"
            svg.append(nl)

            if (!booted && !reduced.matches) {
                booted = true
                svg.classList.add("is-boot")
                setTimeout(() => svg.classList.remove("is-boot"), 900)
            }
            setScrub(scrub)
        }

        const setScrub = (month: number) => {
            scrub = clamp(Math.round(month), 0, SPAN - 1)
            const u = Math.floor(scrub / geo.step)
            bar?.setAttribute("x", String(geo.labelW + u * geo.pitch))
            readout.textContent = `${monthName(scrub)} ${yearOf(scrub)}`
            tag.textContent = scrub === NOW ? "· now" : scrub > NOW ? "· expected" : ""
            const active = new Set(entries.filter(e => e.start <= scrub && e.end >= scrub).map(e => e.key))
            rows.forEach((row, i) => row.toggleAttribute("data-dim", !active.has(entries[i].key)))
            cards.forEach(card => (card.hidden = !active.has(card.dataset.moCard!)))
            empty.hidden = active.size > 0
            svg.setAttribute("aria-valuenow", String(scrub))
            svg.setAttribute("aria-valuetext", readout.textContent)
        }

        const fromPointer = (event: PointerEvent) => {
            const box = svg.getBoundingClientRect()
            const x = ((event.clientX - box.left) / box.width) * svg.viewBox.baseVal.width
            const u = clamp(Math.floor((x - geo.labelW) / geo.pitch), 0, geo.units - 1)
            setScrub(u * geo.step)
        }

        svg.addEventListener("pointerdown", event => {
            svg.setPointerCapture(event.pointerId)
            fromPointer(event)
        })
        svg.addEventListener("pointermove", event => {
            if (event.pointerType === "mouse" || event.buttons) fromPointer(event)
        })
        svg.addEventListener("keydown", event => {
            const moves: Record<string, number> = {
                ArrowRight: geo.step,
                ArrowLeft: -geo.step,
                ArrowUp: 12,
                ArrowDown: -12,
            }
            if (event.key in moves) setScrub(scrub + moves[event.key])
            else if (event.key === "Home") setScrub(0)
            else if (event.key === "End") setScrub(SPAN - 1)
            else return
            event.preventDefault()
            event.stopPropagation() // keep the picker's arrow keys off while scrubbing
        })

        new ResizeObserver(() => render()).observe(root)
    }

    // ---------- Rewind ----------

    // 5 x 7 LED digits.
    const DIGITS = [
        ["01110", "10001", "10011", "10101", "11001", "10001", "01110"],
        ["00100", "01100", "00100", "00100", "00100", "00100", "01110"],
        ["01110", "10001", "00001", "00010", "00100", "01000", "11111"],
        ["11110", "00001", "00001", "01110", "00001", "00001", "11110"],
        ["00010", "00110", "01010", "10010", "11111", "00010", "00010"],
        ["11111", "10000", "11110", "00001", "00001", "10001", "01110"],
        ["00110", "01000", "10000", "11110", "10001", "10001", "01110"],
        ["11111", "00001", "00010", "00100", "01000", "01000", "01000"],
        ["01110", "10001", "10001", "01110", "10001", "10001", "01110"],
        ["01110", "10001", "10001", "01111", "00001", "00010", "01100"],
    ]

    const initRewind = () => {
        const root = document.querySelector<HTMLElement>("[data-rewind]:not([data-ready])")
        if (!root) return
        root.dataset.ready = ""
        const year = root.querySelector<SVGSVGElement>("[data-rw-year]")!
        const month = root.querySelector<HTMLElement>("[data-rw-month]")!
        const tag = root.querySelector<HTMLElement>("[data-rw-tag]")!
        const rail = root.querySelector<HTMLElement>("[data-rw-rail]")!
        const litRail = root.querySelector<HTMLElement>("[data-rw-lit]")!
        const items = [...root.querySelectorAll<HTMLElement>("[data-rw-entry]")]

        // 4 digits x 5 columns, one blank column between digits: 23 x 7 dots.
        const dots: SVGCircleElement[][] = []
        for (let r = 0; r < 7; r++) {
            dots[r] = []
            for (let c = 0; c < 23; c++) {
                const dot = el("circle", { cx: c * 10 + 5, cy: r * 10 + 5, r: 3.6, class: "off" })
                year.append(dot)
                dots[r][c] = dot
            }
        }
        let shownYear = -1
        const setYear = (value: number) => {
            if (value === shownYear) return
            shownYear = value
            const text = String(value)
            for (let r = 0; r < 7; r++)
                for (let c = 0; c < 23; c++) {
                    const d = Math.floor(c / 6)
                    const col = c % 6
                    const on = col < 5 && DIGITS[+text[d]][r][col] === "1"
                    const dot = dots[r][c]
                    dot.setAttribute("class", on ? "on" : "off")
                    if (on) dot.setAttribute("fill", lit((c + (6 - r)) / 28))
                    else dot.removeAttribute("fill")
                }
        }

        const update = () => {
            if (!root.isConnected) {
                removeEventListener("scroll", onScroll)
                return
            }
            const line = innerHeight * 0.5
            const railBox = rail.getBoundingClientRect()
            const nodeTops = items.map(item => item.getBoundingClientRect().top + 8)
            // In scroll distance: the top of the page is now, and each entry's
            // start month is reached as its node crosses the reading line.
            // Every step gets at least 40px so the clock never jumps.
            let s = 0
            const anchors = [{ s: 0, m: NOW }]
            items.forEach((item, i) => {
                s = Math.max(s + 40, nodeTops[i] + scrollY - line)
                anchors.push({ s, m: Number(item.dataset.start) })
            })
            let m = anchors[anchors.length - 1].m
            for (let i = 0; i < anchors.length - 1; i++) {
                const a = anchors[i]
                const b = anchors[i + 1]
                if (scrollY < b.s) {
                    m = a.m + ((b.m - a.m) * clamp(scrollY - a.s, 0, b.s - a.s)) / (b.s - a.s)
                    break
                }
            }
            const mi = Math.round(m)
            setYear(yearOf(mi))
            month.textContent = monthName(mi)
            tag.textContent = mi === NOW ? "· now" : ""
            items.forEach((item, i) => item.toggleAttribute("data-lit", nodeTops[i] <= line))
            const reach = clamp(line - railBox.top, 0, railBox.height)
            litRail.style.clipPath = `inset(0 0 ${railBox.height - reach}px 0)`
        }

        let queued = false
        const onScroll = () => {
            if (queued) return
            queued = true
            requestAnimationFrame(() => {
                queued = false
                update()
            })
        }
        addEventListener("scroll", onScroll, { passive: true })
        addEventListener("resize", onScroll, { passive: true })
        update()
    }

    const init = () => {
        initMonths()
        initRewind()
    }

    init()
    document.addEventListener("proto:mount", init)
</script>
