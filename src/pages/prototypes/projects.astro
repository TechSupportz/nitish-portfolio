---
import Highlight from "@components/Highlight.astro"
import ProjectIcon from "@components/project/ProjectIcon.astro"
import { projectContent } from "@content/projects"
import type { TProjectCategory } from "@src/types/ProjectContentType"
import { Image } from "astro:assets"
import Picker from "./_Picker.astro"
import Shell from "./_Shell.astro"

let count = 0
const groups = (Object.keys(projectContent) as TProjectCategory[]).map(category => ({
    category,
    items: projectContent[category].map(project => ({
        ...project,
        category,
        no: String(++count).padStart(2, "0"),
        id: project.title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
        name: project.title.toLowerCase(),
        // Titles that already end in punctuation don't get a second full stop.
        stop: !/[.?!]$/.test(project.title),
        host: new URL(project.url).hostname.replace(/^www\./, ""),
        stack: project.icons.map(icon => icon.toLowerCase()).join(" · "),
    })),
}))
const all = groups.flatMap(group => group.items)
const first = all[0]
const imageWidths = [300, 450, 600, 800, 900]
---

<Shell title="projects · prototype" headerTitle="projects" active="projects">
    <div class="lg:flex lg:px-12 lg:pt-12 xl:px-16">
        <!-- Sidebar: terminal output. Each category is listed once, the first time
             you reach it; scrolling back only moves the highlight. -->
        <aside class="fixed hidden h-[calc(100dvh-21rem)] justify-between lg:flex lg:w-[25vw] wmax:max-w-100">
            <nav data-ls class="font-code flex min-h-0 min-w-0 flex-col pr-6 text-sm" aria-label="Projects">
                <p>
                    <span class="p-stop">❯</span> ls ./projects
                </p>
                <div class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1">
                    {
                        groups.map(group => (
                            <button
                                type="button"
                                data-ls-dir={group.category}
                                data-active={group.category === first.category ? "" : undefined}
                                class="p-ls-dir"
                            >
                                {group.category}/
                            </button>
                        ))
                    }
                </div>
                <div data-ls-scroll class="p-ls-scroll min-h-0 flex-1 overflow-y-auto">
                {
                    groups.map(group => (
                        <div
                            data-ls-block={group.category}
                            hidden={group.category !== first.category}
                            class="mt-5"
                        >
                            <p>
                                <span class="p-stop">❯</span> ls ./<span data-ls-cmd>{group.category}</span>
                            </p>
                            <ul
                                data-ls-list
                                data-in={group.category === first.category ? "" : undefined}
                                class="mt-2 space-y-0.5"
                            >
                                {group.items.map((project, i) => (
                                    <li style={`--i:${i}`}>
                                        <button
                                            type="button"
                                            data-ls-row={project.id}
                                            data-active={project.id === first.id ? "" : undefined}
                                            class="group p-ls-row flex items-baseline gap-3 text-left"
                                        >
                                            <span class="p-ls-no text-xs">{project.no}</span>
                                            <span class="font-sans text-base xl:text-lg">
                                                <Highlight>{project.name}</Highlight>
                                                <span class="p-ls-stop">.</span>
                                            </span>
                                        </button>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
                <p data-ls-prompt class="mt-5">
                    <span class="p-stop">❯</span><span class="p-cursor" aria-hidden="true"></span>
                </p>
                </div>
            </nav>
            <div
                class="mr-10 h-full w-1 overflow-clip"
                style="mask-image: linear-gradient(to top,transparent,15%,transparent,35%,white,75%,white,transparent)"
            >
                <div
                    data-divider
                    class="h-[1000vh] w-px border-r-[3.5px] border-dotted opacity-70"
                >
                </div>
            </div>
        </aside>
        <div
            id="stage"
            class="min-h-dvh w-full px-6 pb-48 md:px-8 lg:ml-[25vw] lg:w-3/4 lg:px-0 lg:pb-40 wmax:ml-100"
        >
        </div>
    </div>

    <!-- Below lg: the working directory, updating as you scroll. It sits above
         the picker pill here; without the picker it would drop to the bottom. -->
    <div class="pointer-events-none fixed inset-x-0 bottom-0 z-10 lg:hidden" aria-hidden="true">
        <div class="absolute inset-0 bg-progressive-blur-to-t"></div>
        <p class="font-code relative truncate px-4 pt-6 pb-18 text-sm sm:px-6">
            <span class="p-stop">❯</span> ./<span data-pwd>{first.category}/{first.name}</span>
        </p>
    </div>

    <!-- Spec sheet: resume-style split rows, at body-copy scale -->
    <template data-proto-variant>
        <div class="flex motion-preset-focus flex-col gap-12 motion-duration-700 lg:gap-16">
            {
                all.map(project => (
                    <a
                        href={project.url}
                        target="_blank"
                        id={project.id}
                        data-card
                        data-category={project.category}
                        data-name={project.name}
                        class="group grid scroll-mt-72 items-center gap-5 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-8 xl:gap-10"
                    >
                        <Image
                            class="w-full rounded-md outline-2 outline-white/10 transition-[outline-color] duration-200 ease-out group-hover:outline-white/35"
                            src={project.imageUrl}
                            alt={`${project.title} preview`}
                            width={900}
                            height={600}
                            widths={imageWidths}
                            sizes="(min-width: 1024px) 34vw, (min-width: 768px) 46vw, 92vw"
                        />
                        <div class="max-w-[60ch]">
                            <div class="font-code flex justify-between gap-4 text-xs text-white/55">
                                <span>
                                    {project.no} / {project.category}
                                </span>
                                <span class="transition-colors duration-200 ease-out group-hover:text-white">
                                    {project.host} ↗
                                </span>
                            </div>
                            <h2 class="mt-1.5 text-2xl xl:text-[1.75rem]">
                                {project.name}
                                {project.stop && <span class="p-stop">.</span>}
                            </h2>
                            <div class="p-rule p-rule-lit my-3" />
                            <ul class="p-bullets space-y-1 text-[15px] leading-relaxed text-pretty text-white/85 lg:text-base">
                                <li>{project.description}</li>
                                {project.additionalDescription && (
                                    <li>{project.additionalDescription}</li>
                                )}
                            </ul>
                            <div class="mt-3.5 flex items-center">
                                <div class="flex items-center gap-2">
                                    {project.icons.map(icon => (
                                        <ProjectIcon type={icon} class="size-4.5" />
                                    ))}
                                </div>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>
    </template>

    <Picker names={["Spec sheet"]} replay />
</Shell>

<style is:global>
    /* ---------- sidebar terminal ---------- */

    .p-ls-dir {
        color: rgb(255 255 255 / 0.45);
        transition: color 150ms ease-out;
    }

    .p-ls-dir:hover,
    .p-ls-dir[data-active] {
        color: #fff;
    }

    .p-ls-dir[data-active] {
        text-decoration: underline dotted var(--accent);
        text-underline-offset: 4px;
        text-decoration-thickness: 2px;
    }

    .p-ls-row {
        color: rgb(255 255 255 / 0.5);
        transition: color 150ms ease-out;
    }

    .p-ls-row:hover,
    .p-ls-row[data-active] {
        color: #fff;
    }

    .p-ls-no {
        color: rgb(255 255 255 / 0.35);
    }

    .p-ls-row[data-active] .p-ls-no {
        color: var(--accent);
    }

    /* The project in view gets the brand's full stop. */
    .p-ls-stop {
        color: var(--accent);
        opacity: 0;
        transition: opacity 150ms ease-out;
    }

    .p-ls-row[data-active] .p-ls-stop {
        opacity: 1;
    }

    /* Terminal scrollback: older listings slide up and fade under the pinned
       header. No visible scrollbar; the fade only shows once scrolled. */
    .p-ls-scroll {
        scrollbar-width: none;
        overscroll-behavior: contain;
    }

    .p-ls-scroll::-webkit-scrollbar {
        display: none;
    }

    .p-ls-scroll[data-scrolled] {
        mask-image: linear-gradient(to bottom, transparent, white 3rem);
    }

    /* ls output lands all at once once the command has typed, like a real
       terminal. No fade: the typing is the only motion. */
    [data-ls-list]:not([data-in]) {
        visibility: hidden;
    }

    @media (prefers-reduced-motion: reduce) {
        .p-ls-row,
        .p-ls-stop {
            transition: none;
        }
    }
</style>

<script>
    const reduced = matchMedia("(prefers-reduced-motion: reduce)")
    const TYPE_MS = 28
    const PRINT_PAUSE_MS = 70

    const side = document.querySelector<HTMLElement>("[data-ls]")
    const dirs = [...(side?.querySelectorAll<HTMLElement>("[data-ls-dir]") ?? [])]
    const blocks = [...(side?.querySelectorAll<HTMLElement>("[data-ls-block]") ?? [])]
    const rows = [...(side?.querySelectorAll<HTMLElement>("[data-ls-row]") ?? [])]
    const prompt = side?.querySelector<HTMLElement>("[data-ls-prompt]")
    const scroller = side?.querySelector<HTMLElement>("[data-ls-scroll]")
    const motion = (): ScrollBehavior => (reduced.matches ? "instant" : "smooth")

    // Keep an element of the scrollback in view without touching the page scroll.
    const keepInView = (el: HTMLElement, toBottom = false) => {
        if (!scroller) return
        const box = scroller.getBoundingClientRect()
        const r = el.getBoundingClientRect()
        const pad = 48
        let top = scroller.scrollTop
        if (toBottom) top = scroller.scrollHeight
        else if (r.top < box.top + pad) top += r.top - box.top - pad
        else if (r.bottom > box.bottom - 8) top += r.bottom - box.bottom + 8
        else return
        scroller.scrollTo({ top, behavior: motion() })
    }

    scroller?.addEventListener(
        "scroll",
        () => scroller.toggleAttribute("data-scrolled", scroller.scrollTop > 2),
        { passive: true },
    )
    const pwd = document.querySelector<HTMLElement>("[data-pwd]")
    const divider = document.querySelector<HTMLElement>("[data-divider]")

    let currentId = rows.find(row => row.hasAttribute("data-active"))?.dataset.lsRow ?? ""
    let currentCat = dirs.find(dir => dir.hasAttribute("data-active"))?.dataset.lsDir ?? ""
    const revealed = new Set([currentCat])
    let timer: ReturnType<typeof setTimeout> | undefined
    // Completes the reveal that is still typing, if any.
    let finishPending: (() => void) | null = null

    const cards = () => [...document.querySelectorAll<HTMLElement>("#stage [data-card]")]

    // First visit to a category runs `ls` once: the block is appended under the
    // earlier ones, the dir name types out, then the listing prints. If another
    // category arrives mid-type, the current one completes instantly first.
    const reveal = (cat: string) => {
        if (revealed.has(cat)) return
        revealed.add(cat)
        finishPending?.()
        const block = blocks.find(item => item.dataset.lsBlock === cat)
        const cmd = block?.querySelector<HTMLElement>("[data-ls-cmd]")
        const list = block?.querySelector<HTMLElement>("[data-ls-list]")
        if (!block || !cmd || !list) return
        prompt?.before(block) // stack in the order they were reached
        block.hidden = false
        if (prompt) keepInView(prompt, true) // new output lands at the prompt

        const print = () => {
            clearTimeout(timer)
            if (finishPending === print) finishPending = null
            cmd.textContent = cat
            list.setAttribute("data-in", "")
        }

        if (reduced.matches) {
            print()
            return
        }

        let typed = 0
        cmd.textContent = ""
        finishPending = print
        const type = () => {
            if (finishPending !== print) return
            cmd.textContent = cat.slice(0, ++typed)
            timer = setTimeout(typed < cat.length ? type : print, typed < cat.length ? TYPE_MS : PRINT_PAUSE_MS)
        }
        timer = setTimeout(type, TYPE_MS)
    }

    const showCategory = (cat: string) => {
        if (cat === currentCat) return
        currentCat = cat
        dirs.forEach(dir => dir.toggleAttribute("data-active", dir.dataset.lsDir === cat))
        reveal(cat)
    }

    const setActive = (card: HTMLElement) => {
        const id = card.id
        const cat = card.dataset.category ?? ""
        showCategory(cat)
        if (id === currentId) return
        currentId = id
        rows.forEach(row => {
            const on = row.dataset.lsRow === id
            row.toggleAttribute("data-active", on)
            // Scrolling back up brings an earlier listing back into the scrollback view.
            if (on && !row.closest<HTMLElement>("[data-ls-block]")?.hidden) keepInView(row)
        })
        if (pwd) pwd.textContent = `${cat}/${card.dataset.name ?? id}`
    }

    // The card in view is the lowest one whose top has passed a reading line a
    // little under the fixed header. Equal tops (a tile row) keep the left card.
    const update = () => {
        const list = cards()
        if (!list.length) return
        const headerBottom = document.querySelector("h1")?.getBoundingClientRect().bottom ?? 200
        const line = headerBottom + (innerHeight - headerBottom) * 0.3
        let pick = list[0]
        let pickTop = -Infinity
        for (const card of list) {
            const top = card.getBoundingClientRect().top
            if (top <= line && top > pickTop + 1) {
                pick = card
                pickTop = top
            }
        }
        if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) {
            pick = list[list.length - 1]
        }
        setActive(pick)
    }

    let queued = false
    addEventListener(
        "scroll",
        () => {
            // The dotted divider drifts a little with the page, like production.
            if (divider) divider.style.transform = `translateY(-${scrollY / 50}px)`
            if (queued) return
            queued = true
            requestAnimationFrame(() => {
                queued = false
                update()
            })
        },
        { passive: true },
    )
    addEventListener("resize", update, { passive: true })

    const scrollToCard = (card: Element | null | undefined) =>
        card?.scrollIntoView({ block: "start", behavior: reduced.matches ? "instant" : "smooth" })

    dirs.forEach(dir =>
        dir.addEventListener("click", () =>
            scrollToCard(cards().find(card => card.dataset.category === dir.dataset.lsDir)),
        ),
    )
    rows.forEach(row =>
        row.addEventListener("click", () =>
            scrollToCard(document.getElementById(row.dataset.lsRow ?? "")),
        ),
    )

    // Cards re-mount on every variant swap: re-bind hover and re-measure.
    const bindCards = () => {
        cards().forEach(card => {
            if (card.dataset.bound) return
            card.dataset.bound = ""
            card.addEventListener("pointerenter", event => {
                if (event.pointerType === "mouse") setActive(card)
            })
        })
        update()
    }

    bindCards()
    document.addEventListener("proto:mount", bindCards)
</script>
