---
import Logo from "./_Logo.astro"
import Nav from "./_Nav.astro"
import Picker from "./_Picker.astro"
import Shell from "./_Shell.astro"

// The behaviour is decided (boot on load and tap, eased chase on hover);
// the variants compare boot tempo only. Totals match --logo-k in _Shell.
const effect = "stem, shoulder, leg power on in order. the dot flickers alive."
const hover = "light eases into a loop round the mark, then eases back to fully lit."
const variants = [
    { tempo: "brisk", name: "Brisk", total: "1.2s" },
    { tempo: "measured", name: "Measured", total: "1.8s" },
    { tempo: "slow", name: "Slow burn", total: "2.6s" },
] as const
---

<Shell title="logo · prototype" bare>
    <div id="stage" class="h-full"></div>
    {
        variants.map(variant => (
            <template data-proto-variant>
                <div class="fixed top-0 z-20 w-full">
                    <Nav tempo={variant.tempo} active="logo" />
                </div>
                <main class="relative flex h-dvh flex-col items-center justify-center gap-12 px-6 pt-18 pb-20">
                    <div
                        class="p-dotgrid pointer-events-none absolute inset-0"
                        style="--dot-alpha: 0.22; mask-image: radial-gradient(ellipse 65% 55% at 50% 45%, white 15%, transparent 85%)"
                        aria-hidden="true"
                    />
                    <button
                        type="button"
                        data-logo="lit"
                        data-logo-tempo={variant.tempo}
                        class="p-logo-host relative p-6"
                        aria-label="Replay the logo boot"
                    >
                        <Logo class="w-44 md:w-60" />
                    </button>
                    <dl class="font-code relative grid max-w-xl grid-cols-[auto_1fr] gap-x-8 gap-y-1.5 text-sm">
                        <dt class="text-white/50">effect</dt>
                        <dd>{effect}</dd>
                        <dt class="text-white/50">tempo</dt>
                        <dd>
                            {variant.total} · {variant.name.toLowerCase()}
                            <span class="text-white/50">· on load and tap</span>
                        </dd>
                        <dt class="text-white/50">on hover</dt>
                        <dd>{hover}</dd>
                    </dl>
                </main>
            </template>
        ))
    }
    <Picker names={variants.map(variant => variant.name)} replay />
</Shell>
