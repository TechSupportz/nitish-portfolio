---
import githubIcon from "@assets/github.svg"
import linkedInIcon from "@assets/linkedIn.svg"
import DotMatrix from "@components/DotMatrix"
import IconButton from "@components/IconButton.astro"
import { profileRoles } from "@content/profileRoles"
import Layout from "@layouts/Layout.astro"

// Trailing copy of the first role lets the scroller wrap around seamlessly.
// Roles use their short form so "I am a ___" stays on one line beside the icon.
const scrollItems = [...profileRoles, profileRoles[0]]
const scrollItemClass =
    "bg-linear-to-tr from-sky-100 to-blue-500 bg-clip-text text-transparent"
---

<Layout title="Nitish" disableScroll>
    <div class="relative h-full w-full overflow-hidden">
        <DotMatrix
            client:load
            icons={profileRoles.map(role => role.icon)}
            className="fixed inset-x-0 top-[72px] h-[calc((100dvh_-_72px)*0.8)] max-h-[1024px] w-full lg:h-[calc((100dvh_-_72px)*2/3)]"
        />
        <div
            class="relative flex h-full flex-col px-4 xs:px-6 md:px-8 lg:px-12 xl:px-16"
        >
            <div
                class="relative flex min-h-[62%] items-end pt-6 pb-[5vh] lg:h-[60%] lg:pt-0 lg:pb-[5vh]"
            >
                <div
                    class="relative flex min-w-0 flex-1 flex-col gap-1 sm:gap-2"
                >
                    <p
                        data-matrix-dim
                        class="text-md mb-1 motion-preset-blur-right-md motion-duration-1000 xs:text-lg sm:text-xl lg:text-2xl 2xl:text-3xl"
                    >
                        hello, my name is
                    </p>
                    <h1
                        data-matrix-dim
                        class="mb-0.5 motion-preset-blur-right-md text-5xl motion-delay-75 motion-duration-1000 xs:text-6xl sm:text-7xl xl:text-[5rem] 2xl:text-8xl"
                    >
                        Nitish,
                    </h1>
                    <div
                        class="flex motion-preset-blur-right-md flex-wrap items-baseline gap-2 text-5xl motion-delay-100 motion-duration-1000 xs:text-6xl sm:text-7xl lg:text-6xl xl:text-[5rem] 2xl:text-8xl"
                    >
                        <h1 data-matrix-dim>I am a&nbsp;</h1>
                        <div
                            data-matrix-dim-clip
                            class="h-[1.55ch] overflow-hidden font-display font-bold"
                        >
                            <ul
                                id="scroll-list"
                                data-matrix-dim
                                class="text-nowrap transition-transform duration-700 ease-[cubic-bezier(0.65,0,0.35,1)] motion-reduce:transition-none"
                            >
                                {
                                    scrollItems.map(role => (
                                        <li class={scrollItemClass}>
                                            {role.shortRole ?? role.role}
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </div>
                    <div
                        class="mt-2 flex motion-preset-blur-right-md gap-4 motion-delay-150 motion-duration-1000 2xl:gap-6"
                    >
                        <IconButton
                            href="https://github.tnitish.com/"
                            openInNewTab
                        >
                            <img
                                src={githubIcon.src}
                                alt="GitHub Icon"
                                loading={"eager"}
                                width={64}
                                height={64}
                            />
                        </IconButton>
                        <IconButton
                            href="https://linkedin.tnitish.com/"
                            openInNewTab
                        >
                            <img
                                src={linkedInIcon.src}
                                alt="LinkedIn Icon"
                                loading={"eager"}
                                width={64}
                                height={64}
                            />
                        </IconButton>
                    </div>
                </div>
                <div
                    data-matrix-icon-slot
                    class="pointer-events-none absolute inset-0 hidden lg:block"
                >
                </div>
            </div>

            <div class="hidden flex-1 items-center pb-[6vh] lg:flex">
                <ol
                    class="grid w-full motion-preset-blur-up-md grid-cols-3 motion-delay-300 motion-duration-1000"
                >
                    {
                        profileRoles.map((role, index) => (
                            <li
                                data-role-column
                                class="border-l-[3px] border-dotted border-white/20 px-6 opacity-35 transition-opacity duration-500 first:border-l-0 first:pl-0 data-[active=true]:opacity-100 xl:px-8"
                            >
                                <span class="flex gap-1.5" aria-hidden="true">
                                    {Array.from({ length: index + 1 }, () => (
                                        <span class="size-1.5 rounded-full bg-white" />
                                    ))}
                                </span>
                                <h2 class="mt-3 text-xl xl:text-2xl">
                                    {role.title}
                                </h2>
                                <p class="mt-1.5 text-base text-pretty xl:text-lg">
                                    {role.body}
                                </p>
                            </li>
                        ))
                    }
                </ol>
            </div>

            <div class="flex flex-1 items-center pb-[3vh] lg:hidden">
                <button
                    id="role-cycle"
                    type="button"
                    class="flex w-full motion-preset-blur-up-md flex-col gap-3 text-left motion-delay-300 motion-duration-1000"
                >
                    <span class="flex gap-1.5" aria-hidden="true">
                        {
                            profileRoles.map(() => (
                                <span
                                    data-role-dot
                                    class="size-1.5 rounded-full bg-white opacity-0 transition-opacity duration-[350ms] ease-out motion-reduce:transition-none"
                                />
                            ))
                        }
                    </span>
                    <span class="grid-overlap flex-1">
                        {
                            profileRoles.map(role => (
                                <span
                                    data-role-block
                                    aria-hidden="true"
                                    class="block -translate-x-2.5 opacity-0 blur-[6px] transition-[opacity,filter,translate] duration-[550ms] ease-out data-[state=in]:translate-x-0 data-[state=in]:opacity-100 data-[state=in]:blur-[0px] data-[state=out]:translate-x-2 data-[state=out]:duration-[350ms] data-[state=out]:ease-in motion-reduce:transition-none"
                                >
                                    <span class="block font-display text-xl font-bold sm:text-2xl">
                                        {role.title}
                                    </span>
                                    <span class="mt-1.5 block font-light text-pretty sm:text-lg">
                                        {role.body}
                                    </span>
                                </span>
                            ))
                        }
                    </span>
                    <span class="sr-only">Show next role</span>
                </button>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { profileRoles } from "@content/profileRoles"
    import { $activeRole } from "@store/uiStore"

    const ROLE_DURATION_MS = 3600
    const BLOCK_OUT_MS = 380
    const BLOCK_IN_DELAY_MS = 160
    const DOT_IN_STAGGER_MS = 120
    const DOT_OUT_STAGGER_MS = 90

    const roleCount = profileRoles.length
    const scrollList = document.getElementById("scroll-list")
    const columns = document.querySelectorAll<HTMLElement>("[data-role-column]")
    const blocks = document.querySelectorAll<HTMLElement>("[data-role-block]")
    const dots = document.querySelectorAll<HTMLElement>("[data-role-dot]")
    const roleCycle = document.getElementById("role-cycle")

    let roleStartedAt = performance.now()

    const setRole = (index: number) => {
        roleStartedAt = performance.now()
        $activeRole.set(index)
    }

    setInterval(() => {
        if (performance.now() - roleStartedAt < ROLE_DURATION_MS) return
        setRole(($activeRole.get() + 1) % roleCount)
    }, 100)

    // Scroller: one step per role, wrapping through the trailing duplicate
    if (scrollList) {
        const step = 100 / (roleCount + 1)
        let position = 0

        const moveTo = (nextPosition: number) => {
            position = nextPosition
            scrollList.style.transform = `translateY(-${position * step}%)`
        }

        // After scrolling onto the trailing duplicate, snap back to the real first item
        scrollList.addEventListener("transitionend", () => {
            if (position !== roleCount) return
            scrollList.style.transition = "none"
            moveTo(0)
            scrollList.getBoundingClientRect()
            scrollList.style.transition = ""
        })

        $activeRole.subscribe(index => {
            moveTo(
                index === 0 && position === roleCount - 1 ? roleCount : index,
            )
        })
    }

    roleCycle?.addEventListener("click", () =>
        setRole(($activeRole.get() + 1) % roleCount),
    )

    let previous = -1
    // Bumped on every state change so a stale timeout never undoes a newer one
    const blockGeneration = Array.from(blocks, () => 0)
    $activeRole.subscribe(index => {
        columns.forEach((column, i) => {
            column.dataset.active = String(i === index)
        })

        // Mobile: blur the old role out to the right, then blur the new one in from the left
        const outgoing = blocks[previous]
        if (outgoing && previous !== index) {
            const leaving = previous
            const generation = ++blockGeneration[leaving]
            outgoing.dataset.state = "out"
            outgoing.setAttribute("aria-hidden", "true")
            setTimeout(() => {
                if (blockGeneration[leaving] === generation) {
                    delete outgoing.dataset.state
                }
            }, BLOCK_OUT_MS)
        }
        const incoming = blocks[index]
        if (incoming) {
            const generation = ++blockGeneration[index]
            delete incoming.dataset.state
            incoming.removeAttribute("aria-hidden")
            setTimeout(
                () => {
                    if (blockGeneration[index] === generation) {
                        incoming.dataset.state = "in"
                    }
                },
                previous < 0 ? 0 : BLOCK_IN_DELAY_MS,
            )
        }

        // Count dots fade in one by one, extra ones fade out from the end
        const shown = previous + 1
        const wanted = index + 1
        dots.forEach((dot, i) => {
            if (i < wanted && i >= shown) {
                dot.style.transitionDelay = `${(i - shown) * DOT_IN_STAGGER_MS}ms`
                dot.style.opacity = "1"
            } else if (i >= wanted) {
                dot.style.transitionDelay = `${Math.max(0, shown - 1 - i) * DOT_OUT_STAGGER_MS}ms`
                dot.style.opacity = "0"
            } else {
                dot.style.transitionDelay = "0ms"
                dot.style.opacity = "1"
            }
        })

        previous = index
    })
</script>
