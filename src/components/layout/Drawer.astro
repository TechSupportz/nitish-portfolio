---
import githubIcon from "@assets/github.svg"
import linkedInIcon from "@assets/linkedIn.svg"
import X from "@lucide/astro/icons/x"
import { getNavLinks } from "@utils/navLinks"
import Highlight from "@components/Highlight.astro"

const navLinks = getNavLinks(Astro.url.pathname)
---

<div
    id="drawer-backdrop"
    transition:persist="drawer-backdrop"
    class="pointer-events-none fixed inset-0 z-40 h-screen w-full bg-black/45 opacity-0 backdrop-blur-md transition-all duration-500 ease-in-out data-open:pointer-events-auto data-open:opacity-100"
>
</div>
<div
    id="drawer"
    transition:persist="nav-drawer"
    class="fixed top-0 right-0 z-50 h-dvh w-3/4 translate-x-full transform-gpu rounded-l-4xl bg-charcoal shadow-lg transition-all duration-500 ease-in-out data-open:translate-x-0"
>
    <div class="flex size-full flex-col px-4 py-6">
        <div
            class="pointer-events-none absolute inset-y-0 -right-1 h-[90%] w-3/5 bg-[url('/dot-matrix.svg')] bg-repeat opacity-40"
            style="mask-image: linear-gradient(to bottom,transparent,15%,white,80%,transparent)"
        >
        </div>
        <header class="flex justify-end">
            <button
                id="drawer-close"
                class="cursor-pointer"
                aria-label="Close menu"
            >
                <X size="2rem" />
            </button>
        </header>
        <div class="flex-1">
            <div
                class="flex h-full flex-col items-center justify-center gap-10 font-display text-5xl font-extrabold text-white"
            >
                {
                    navLinks.map(({ href, label, isActive }) => (
                        <a href={href} class="group transition duration-300">
                            <Highlight>{label}</Highlight>
                            <span
                                data-nav-dot
                                class:list={[{ "opacity-0": !isActive }]}
                            >
                                {"."}
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>
        <footer class="flex h-fit items-center justify-center gap-8 opacity-50">
            <a href="https://github.tnitish.com/">
                <img src={githubIcon.src} alt="GitHub" class="size-10" />
            </a>
            <a href="https://linkedin.tnitish.com/">
                <img src={linkedInIcon.src} alt="LinkedIn" class="size-10" />
            </a>
        </footer>
    </div>
</div>

<script>
    import { isDrawerOpen } from "@store/uiStore"
    import { getNavLinks } from "@utils/navLinks"

    // These nodes persist across every route, so bind their listeners once.
    const drawer = document.getElementById("drawer")
    const backdrop = document.getElementById("drawer-backdrop")

    isDrawerOpen.subscribe(isOpen => {
        drawer?.toggleAttribute("data-open", isOpen)
        backdrop?.toggleAttribute("data-open", isOpen)
    })

    const closeDrawer = () => isDrawerOpen.set(false)
    backdrop?.addEventListener("click", closeDrawer)
    document.getElementById("drawer-close")?.addEventListener("click", closeDrawer)

    document.addEventListener("astro:after-swap", () => {
        // Persisting the drawer also preserves its markup; refresh its dot.
        for (const { href, isActive } of getNavLinks(location.pathname)) {
            drawer?.querySelector(`a[href="${href}"] > [data-nav-dot]`)
                ?.classList.toggle("opacity-0", !isActive)
        }
        // Flush the persisted drawer's open position after reparenting it.
        // Closing now lets its live CSS transition cover the incoming page.
        drawer?.getBoundingClientRect()
        closeDrawer()
    })
</script>
