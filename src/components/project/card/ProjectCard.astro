---
// Image on the left (45%), words on the right in three parts: the title on
// the image's top edge, the description, then a small "link / built with"
// spec straight after it.
import Highlight from "@components/Highlight.astro"
import ProjectIcon from "./ProjectIcon.astro"
import type { TListedProject } from "@src/types/ProjectContentType"
import { Image } from "astro:assets"

type Props = TListedProject

const {
    id,
    name,
    title,
    category,
    description,
    additionalDescription,
    imageUrl,
    icons,
    url,
} = Astro.props

// Titles that already end in punctuation don't get a second full stop.
const stop = !/[.?!]$/.test(title)
const host = new URL(url).hostname.replace(/^www\./, "")
// Hover brackets: one L per corner, a corner dot plus a 3-dot arm each way,
// as [x, y] in dot steps. Each corner is this L mirrored.
const L_DOTS = [
    [0, 0],
    [1, 0],
    [2, 0],
    [3, 0],
    [0, 1],
    [0, 2],
    [0, 3],
]
---

<a
    href={url}
    target="_blank"
    id={id}
    data-project-card
    data-category={category}
    data-name={name}
    class="group grid scroll-mt-62 items-start gap-5 xs:scroll-mt-66 md:scroll-mt-78 md:grid-cols-[minmax(0,9fr)_minmax(0,11fr)] md:gap-8 lg:scroll-mt-72 xl:gap-10"
>
    <div class="relative">
        <span class="card-brackets" aria-hidden="true">
            {["tl", "tr", "bl", "br"].map(corner => (
                <span class:list={["card-corner", corner]}>
                    {L_DOTS.map(([x, y]) => (
                        <b style={`--x:${x};--y:${y}`} />
                    ))}
                </span>
            ))}
        </span>
        <div class="overflow-hidden rounded-md">
            <Image
                class="card-img w-full"
                src={imageUrl}
                alt={`${title} preview`}
                width={900}
                height={600}
                widths={[300, 450, 600, 800, 900]}
                sizes="(min-width: 1024px) 32vw, (min-width: 768px) 44vw, 92vw"
            />
        </div>
    </div>
    <div>
        <h2 class="pt-1 card-title text-3xl leading-tight">
            {title}
            {stop && <span class="text-blue-400">.</span>}
        </h2>
        <div class="mt-2 max-w-[46ch] text-[15px] leading-relaxed text-pretty lg:text-base">
            <p class="font-normal text-white/85">{description}</p>
            {additionalDescription && (
                <p class="mt-2 font-normal text-white/55">
                    {additionalDescription}
                </p>
            )}
        </div>
        <dl class="mt-7 mb-2 grid grid-cols-[5.5rem_minmax(0,1fr)] items-center gap-y-2 text-xs">
            <dt class="text-white/35">link</dt>
            <dd class="text-white/60">
                <Highlight>{host}</Highlight>
            </dd>
            <dt class="text-white/35">built with</dt>
            <dd class="flex gap-2">
                {icons.map(icon => (
                    <ProjectIcon type={icon} class="size-4" />
                ))}
            </dd>
        </dl>
    </div>
</a>

<style>
    /* Optical alignment: the top of the capitals sits on the image's top
       edge, not the top of the line box. */
    .card-title {
        margin-top: -0.3em;
    }

    /* Hover: viewfinder brackets, one L of lit dots per corner (the brand's
       3px dot on a 7px pitch), each fading up while sliding 4px in from its
       corner. Corners take their colour from where they sit on the brand
       gradient. The image also scales up a touch inside its frame. */
    .card-brackets {
        position: absolute;
        inset: -11px;
        pointer-events: none;
    }

    .card-corner {
        position: absolute;
        width: 24px;
        height: 24px;
        opacity: 0;
        translate: var(--tx) var(--ty);
        transition:
            opacity 200ms ease-out,
            translate 300ms var(--ease-out-strong);
    }

    .card-corner.tl {
        top: 0;
        left: 0;
        --c: var(--color-grad-from);
        --tx: -4px;
        --ty: -4px;
    }

    .card-corner.tr {
        top: 0;
        right: 0;
        transform: scaleX(-1);
        --c: color-mix(in oklab, var(--color-grad-from), var(--color-grad-to));
        --tx: 4px;
        --ty: -4px;
    }

    .card-corner.bl {
        bottom: 0;
        left: 0;
        transform: scaleY(-1);
        --c: color-mix(in oklab, var(--color-grad-from), var(--color-grad-to));
        --tx: -4px;
        --ty: 4px;
    }

    .card-corner.br {
        right: 0;
        bottom: 0;
        transform: scale(-1);
        --c: var(--color-grad-to);
        --tx: 4px;
        --ty: 4px;
    }

    .card-corner b {
        position: absolute;
        left: calc(var(--x) * 7px);
        top: calc(var(--y) * 7px);
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: var(--c);
    }

    .card-img {
        transition: transform 400ms var(--ease-out-strong);
    }

    @media (hover: hover) {
        .group:hover .card-corner {
            opacity: 1;
            translate: 0 0;
        }

        .group:hover .card-img {
            transform: scale(1.03);
        }
    }

    .group:focus-visible .card-corner {
        opacity: 1;
        translate: 0 0;
    }

    @media (prefers-reduced-motion: reduce) {
        .card-img,
        .card-corner {
            transition: none;
        }

        .group:hover .card-img {
            transform: none;
        }
    }

    @supports (text-box: trim-start cap alphabetic) {
        .card-title {
            margin-top: 0;
            text-box: trim-start cap alphabetic;
        }
    }
</style>
