---
// Below lg: the working directory, updating as you scroll. Driven by the
// script in projects.astro.
type Props = {
    category: string
    name: string
}

const { category, name } = Astro.props
---

<div
    class="pointer-events-none fixed inset-x-0 bottom-0 z-10 motion-preset-focus motion-delay-75 motion-duration-1000 lg:hidden"
    aria-hidden="true"
>
    <div class="absolute inset-0 bg-progressive-blur-to-t"></div>
    <p class="relative flex items-center truncate px-4 pt-6 pb-4 font-code text-sm font-normal sm:px-6">
        <span class="mr-[0.6em] size-1.5 shrink-0 rounded-full bg-blue-400"></span>
        ./<span data-pwd class="truncate">{category}/{name}</span>
    </p>
</div>
