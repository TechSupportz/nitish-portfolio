---
// Terminal scrollback. `ls projects` lists the categories; each category's
// `ls -l` prints the first time you reach it, stacked under the last. The
// prompt dot is blue for the category you're in. The rendered HTML shows the
// first category already printed; the script in projects.astro types it in
// (data-text is the command, data-in marks printed output).
import type { TListedProject, TProjectCategory } from "@src/types/ProjectContentType"

type Props = {
    groups: { category: TProjectCategory; items: TListedProject[] }[]
}

const { groups } = Astro.props
const first = groups[0]
---

<nav
    data-ls
    class="ls-scroll h-full min-h-0 min-w-0 overflow-hidden pr-6 font-code text-sm"
    aria-label="Projects"
>
    <!-- The script slides this track to follow the project in view. -->
    <div data-ls-track class="will-change-transform">
    <div data-ls-block="projects" class="mb-4">
        <p class="ls-line">
            <span class="ls-dot"></span>
            <span data-ls-cmd data-text="ls projects">ls projects</span>
            <span class="ls-cursor ls-cmd-cursor"></span>
        </p>
        <div data-ls-out data-in class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1">
            {
                groups.map(({ category, items }, i) => (
                    <button
                        type="button"
                        style={`--i:${i}`}
                        data-ls-dir={category}
                        data-ls-jump={items[0].id}
                        data-active={category === first.category ? "" : undefined}
                        class="ls-dir"
                    >
                        {category}/
                    </button>
                ))
            }
        </div>
    </div>
    {
        groups.map(({ category, items }) => (
            <div
                data-ls-block={category}
                data-on={category === first.category ? "" : undefined}
                hidden={category !== first.category}
                class="mb-4"
            >
                <p class="ls-line">
                    <span class="ls-dot" />
                    <span data-ls-cmd data-text={`ls -l ${category}`}>
                        ls -l {category}
                    </span>
                    <span class="ls-cursor ls-cmd-cursor" />
                </p>
                <ul
                    data-ls-out
                    data-in={category === first.category ? "" : undefined}
                    class="mt-1.5 font-sans text-base leading-[1.4]"
                >
                    {items.map((project, i) => (
                        <li style={`--i:${i}`}>
                            <button
                                type="button"
                                data-ls-row={project.id}
                                data-ls-jump={project.id}
                                data-active={
                                    project.id === first.items[0].id ? "" : undefined
                                }
                                class="ls-row text-left"
                            >
                                {project.name}
                            </button>
                        </li>
                    ))}
                </ul>
            </div>
        ))
    }
    <p data-ls-prompt class="ls-line ls-live">
        <span class="ls-dot"></span>
        <span class="ls-cursor"></span>
    </p>
    </div>
</nav>

<style is:global>
    /* The script slides the listing to follow you; it isn't scrolled by
       hand. A fade at the top, as tall as the distance moved (up to 48px),
       shows when lines have slid off. */
    .ls-scroll {
        mask-image: linear-gradient(
            to bottom,
            transparent,
            white var(--ls-fade, 0px)
        );
    }

    /* Command lines: the dot is centred on the text, not on its baseline. */
    .ls-line {
        display: flex;
        align-items: center;
        font-weight: 400;
    }

    /* The prompt dot: dim by default, blue for the category you're in and
       for the live prompt. It fades between the two. */
    .ls-dot {
        display: inline-block;
        flex: none;
        width: 6px;
        height: 6px;
        margin-right: 0.6em;
        border-radius: 50%;
        vertical-align: middle;
        background: rgb(255 255 255 / 0.22);
        transition: background-color 300ms ease;
    }

    [data-on] > .ls-line .ls-dot,
    .ls-live .ls-dot {
        background: var(--color-blue-400);
    }

    /* Block cursor: solid while typing, blinking at rest. A command line
       shows its own cursor only while it types. */
    .ls-cursor {
        display: inline-block;
        width: 0.55em;
        height: 1.1em;
        background: rgb(255 255 255 / 0.85);
        animation: term-blink 1.1s steps(1, end) infinite;
    }

    [data-typing] + .ls-cursor {
        animation: none;
    }

    .ls-cmd-cursor {
        display: none;
    }

    [data-typing] + .ls-cmd-cursor {
        display: inline-block;
    }

    .ls-dir {
        color: rgb(255 255 255 / 0.45);
        transition: color 150ms ease-out;
    }

    .ls-row {
        color: rgb(255 255 255 / 0.55);
        transition: color 150ms ease-out;
    }

    .ls-dir:hover,
    .ls-dir[data-active],
    .ls-row:hover,
    .ls-row[data-active] {
        color: white;
    }

    /* Output streams in: each line appears instantly, 45ms after the one
       above it. Hidden until its command has typed (data-in). */
    [data-ls-out]:not([data-in]) > * {
        visibility: hidden;
        pointer-events: none;
    }

    [data-ls-out][data-in] > * {
        transition: visibility 0s linear calc(var(--i, 0) * 45ms);
    }

    @media (prefers-reduced-motion: reduce) {
        .ls-cursor {
            animation: none;
        }

        .ls-dir,
        .ls-row,
        [data-ls-out] > * {
            transition: none;
        }
    }
</style>
