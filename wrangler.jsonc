{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Assets-only Worker serving the static Astro build. Build/deploy commands,
	// build env vars (PNPM_VERSION) and the custom domain are set in the
	// Workers Builds dashboard, not here.
	"name": "nitish-portfolio",
	"compatibility_date": "2026-10-13",
	"assets": {
		"directory": "./dist",
		// Serve dist/404.html with a 404 status for unknown routes
		"not_found_handling": "404-page",
	},
	"preview_urls": true,
}
